{
  "name": "accessguard-dev",
  "url": "https://github.com/anish-2025dev/accessguard",
  "description": "Reports access-control regressions in pull requests: who can access what, and did this change make it worse?",
  "request_oauth_on_install": false,
  "default_permissions": {
    "contents": "read",
    "pull_requests": "write",
    "checks": "write",
    "issues": "write",
    "metadata": "read"
  },
  "default_events": [
    "pull_request",
    "push",
    "issue_comment",
    "check_run"
  ],
  "public": false,
  "hook_attributes": {
    "url": "https://smee.io/REPLACE-WITH-YOUR-CHANNEL"
  },
  "redirect_url": "http://localhost:8000/manifest/redirect",
  "callback_urls": [
    "http://localhost:8000/callback"
  ],
  "setup_url": "http://localhost:8000/connect"
}
